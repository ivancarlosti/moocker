# Default port to expose the application locally.
MOODLE_PORT=8080

# The Public URL of your Moodle instance.
# If using a reverse proxy, set this to your domains URL (e.g. https://moodle.yourdomain.com)
MOODLE_URL=http://localhost:8080

# (Optional) Force SSL proxy mode. Auto-detected from MOODLE_URL scheme by default.
# Set to "true" or "false" only if auto-detection gets it wrong.
# MOODLE_SSLPROXY=true

DB_HOST=host.docker.internal
DB_NAME=moodledb
DB_USER=moodleuser
DB_PASSWORD=moodlepass
